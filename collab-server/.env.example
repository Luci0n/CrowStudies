# Public address clients connect to. It is intentionally configured in the
# web app separately; never put any Firebase Admin credential there.
PORT=1234
HOST=127.0.0.1

# Either one works. Prefer GOOGLE_APPLICATION_CREDENTIALS on a server.
GOOGLE_APPLICATION_CREDENTIALS=/srv/crowstudies/firebase-admin.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Used only for server-side CORS checks and audit logs.
ALLOWED_ORIGIN=https://luci0n.github.io
