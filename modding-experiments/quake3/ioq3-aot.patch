diff --git a/code/qcommon/vm.c b/code/qcommon/vm.c
index 9de7e15..f91909d 100644
--- a/code/qcommon/vm.c
+++ b/code/qcommon/vm.c
@@ -33,7 +33,32 @@ and one exported function: Perform
 
 */
 
+#define VM_CALL_NO_PAD
 #include "vm_local.h"
+#include <dlfcn.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+/* modding-experiments: AOT backend + differential-test probe.
+   QVM_AOT=<path.so>  run that recompiled module instead of interpreting <module>.qvm
+   QVM_AOT_MODULE     which module (default qagame)
+   QVM_HASHLOG=<file> after every top-level VM_Call into that module, log callnum, arg0 and a
+                      64-bit hash of the whole VM data image (globals + heap + VM stack). */
+typedef struct {
+	int *programStack; byte *dataBase; int dataMask;
+	intptr_t (*systemCall)(intptr_t *);
+	void (*blockCopy)(unsigned int, unsigned int, size_t);
+	void (*error)(const char *);
+} aotEnv_t;
+static void AOT_Error(const char *msg) { Com_Error(ERR_DROP, "AOT: %s", msg); }
+static FILE *hashLog;
+static const char *AOT_Module(void) { const char *m = getenv("QVM_AOT_MODULE"); return m ? m : "qagame"; }
+static unsigned long long VM_HashImage(vm_t *vm) {
+	unsigned long long h = 1469598103934665603ULL; const unsigned long long *p = (const unsigned long long *)vm->dataBase;
+	int i, n = (vm->dataMask + 1) / 8;
+	for (i = 0; i < n; i++) { h ^= p[i]; h *= 1099511628211ULL; h ^= h >> 29; }
+	return h;
+}
 
 
 vm_t	*currentVM = NULL;
@@ -677,6 +702,18 @@ vm_t *VM_Create( const char *module, intptr_t (*systemCalls)(intptr_t *),
 	// load the map file
 	VM_LoadSymbols( vm );
 
+	if ( getenv("QVM_AOT") && !Q_stricmp(module, AOT_Module()) ) {
+		void *h = dlopen(getenv("QVM_AOT"), RTLD_NOW);
+		void (*init)(aotEnv_t *) = h ? (void (*)(aotEnv_t *))dlsym(h, "aot_init") : NULL;
+		static aotEnv_t env;
+		if (!init) Com_Error(ERR_FATAL, "QVM_AOT: cannot load %s: %s", getenv("QVM_AOT"), dlerror());
+		env.programStack = &vm->programStack; env.dataBase = vm->dataBase; env.dataMask = vm->dataMask;
+		env.systemCall = systemCalls; env.blockCopy = VM_BlockCopy; env.error = AOT_Error;
+		init(&env);
+		vm->aotCall = (int (*)(int *))dlsym(h, "aot_call");
+		Com_Printf("QVM_AOT: %s runs recompiled code from %s\n", module, getenv("QVM_AOT"));
+	}
+
 	// the stack is implicitly at the end of the image
 	vm->programStack = vm->dataMask + 1;
 	vm->stackBottom = vm->programStack - PROGRAM_STACK_SIZE;
@@ -808,7 +845,7 @@ intptr_t QDECL VM_Call( vm_t *vm, int callnum, ... )
 {
 	vm_t	*oldVM;
 	intptr_t r;
-	int i;
+	int i, arg0 = 0;
 
 	if(!vm || !vm->name[0])
 		Com_Error(ERR_FATAL, "VM_Call with NULL vm");
@@ -857,6 +894,10 @@ intptr_t QDECL VM_Call( vm_t *vm, int callnum, ... )
 			a.args[i] = va_arg(ap, int);
 		}
 		va_end(ap);
+		arg0 = a.args[0];
+		if ( vm->aotCall )
+			r = vm->aotCall( &a.callnum );
+		else
 #ifdef HAVE_VM_COMPILED
 		if ( vm->compiled )
 			r = VM_CallCompiled( vm, &a.callnum );
@@ -867,6 +908,18 @@ intptr_t QDECL VM_Call( vm_t *vm, int callnum, ... )
 	}
 	--vm->callLevel;
 
+	if ( vm->callLevel == 0 && !vm->entryPoint && getenv("QVM_HASHLOG") && !Q_stricmp(vm->name, AOT_Module()) ) {
+		if (!hashLog) hashLog = fopen(getenv("QVM_HASHLOG"), "w");
+		static int nlogged;
+		extern unsigned long long qvm_syscallHash;
+		fprintf(hashLog, "%d %d %d %016llx %016llx\n", callnum, arg0, (int)r, VM_HashImage(vm), qvm_syscallHash);
+		if ( getenv("QVM_DUMP_AT") && atoi(getenv("QVM_DUMP_AT")) == nlogged ) {
+			FILE *f = fopen(va("%s.dump", getenv("QVM_HASHLOG")), "wb");
+			fwrite(vm->dataBase, 1, vm->dataMask + 1, f); fclose(f);
+		}
+		nlogged++;
+	}
+
 	if ( oldVM != NULL )
 	  currentVM = oldVM;
 	return r;
